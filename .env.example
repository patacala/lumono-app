# =============================================================================
# Lumono - Variables de entorno para Coolify / producción
# =============================================================================
# Copia este archivo en Coolify como variables de entorno del stack Compose.
# En Coolify v4 también puedes usar variables mágicas:
#   ${SERVICE_URL_WEB}  → URL pública del frontend
#   ${SERVICE_URL_API}  → URL pública del backend
#   ${SERVICE_PASSWORD_POSTGRES} → password auto-generado
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=lumono
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=lumono_inventory

# --- API (NestJS) ---
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
LOG_LEVEL=info

# URL pública del frontend (para CORS en la API)
# En Coolify: CORS_ORIGIN=${SERVICE_URL_WEB}
CORS_ORIGIN=https://app.tudominio.com

# URL pública de la API (para el frontend - se usa en BUILD y runtime)
# En Coolify: NEXT_PUBLIC_API_URL=${SERVICE_URL_API}
NEXT_PUBLIC_API_URL=https://api.tudominio.com

# Ejecutar seed en el primer deploy (admin@lumono.com / admin123)
RUN_SEED=true
