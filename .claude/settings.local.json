      "Bash(npx prisma migrate dev:*)",
      "Bash(npm run dev:*)",
      "Bash(lsof:*)",
      "Bash(xargs kill -9)",
      "WebSearch",
      "Bash(wc:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm uninstall:*)",
      "WebFetch(domain:github.com)",
