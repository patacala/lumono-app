  "hooks": {
    "PreCommit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/peterbarranco/Desktop/lumono && npm run lint"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_FILE_PATH\" | grep -q 'schema.prisma'; then cd /Users/peterbarranco/Desktop/lumono/apps/api && npx prisma generate; fi"
          }
        ]
      }
    ]
  }
}
